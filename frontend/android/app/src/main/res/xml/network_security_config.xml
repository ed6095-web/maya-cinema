<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!--
      MAYA Development Network Security Config
      Allows cleartext HTTP to localhost, local LAN IPs (Wi-Fi), and emulator host.
    -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
