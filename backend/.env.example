# MAYA Backend — Environment Configuration
# Copy this file to .env and fill in your values.

# Database
DATABASE_URL=sqlite+aiosqlite:///./maya.db

# JWT
JWT_SECRET=change-this-to-a-long-random-secret-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# Media storage paths (relative to backend/)
MEDIA_DIRECTORY=media/movies
POSTER_DIRECTORY=media/posters
THUMBNAIL_DIRECTORY=media/thumbnails

# Server
API_HOST=0.0.0.0
API_PORT=8000

# CORS — comma-separated allowed origins
# For development: http://localhost, http://10.0.2.2 (Android emulator)
CORS_ORIGINS=http://localhost,http://localhost:8000,http://10.0.2.2:8000,http://127.0.0.1:8000

# Initial admin account (used by seed.py only)
MAYA_ADMIN_USERNAME=admin
MAYA_ADMIN_EMAIL=admin@maya.local
MAYA_ADMIN_PASSWORD=changeme123
